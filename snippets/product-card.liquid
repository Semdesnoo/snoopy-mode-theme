{%- comment -%}
  Productkaart (.product-card), v10 in Rano-stijl.
  Gebruik: {% render 'product-card', product: product %}
  Vorm van de foto, labels en hover-foto stel je in bij Thema-instellingen > Productkaarten.

  Telefoonfoto's (staand, vaak schermvullend) vallen in een vaste 2:3-uitsnede, zodat
  alle kaarten even groot zijn. Heeft een foto een focuspunt in Shopify, dan zet
  image_tag zelf de juiste object-position: de uitsnede schuift dan mee.

  Optioneel:
    force_badge       tekst die op elke foto komt (bijv. "Aanbieding" op de Sale-pagina)
    force_badge_style 'sale', 'dark' of 'soft'
    sizes             breedte op het scherm, voor de juiste fotomaat
{%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign save = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
  endif
  assign is_new = false
  if product.tags contains 'nieuw' or product.tags contains 'Nieuw'
    assign is_new = true
  endif
  assign ratio = settings.card_image_ratio | default: 'tall'
  assign fit_class = ''
  if settings.card_image_contain
    assign fit_class = ' sm-fit-contain'
  endif
  assign badge_new = settings.badge_new_label | default: 'Nieuw'
  assign badge_sale = settings.badge_sale_label | default: 'Sale'
  assign card_sizes = sizes | default: '(max-width: 749px) 48vw, (max-width: 989px) 31vw, 24vw'
  assign img = product.featured_media
  assign img2 = product.media[1]
  assign alt_text = img.alt | default: product.title
  assign alt_text2 = img2.alt | default: product.title | append: ' - tweede foto'
-%}
<article class="product-card card-v10 reveal" data-card>
  <div class="card-v10__media">
  <a class="product-card__media-wrap" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if img -%}
      <div class="media sm-ratio-{{ ratio }}{{ fit_class }}{% if settings.card_hover_image and img2 %} has-alt{% endif %}">
        {{ img | image_url: width: 900 | image_tag: loading: 'lazy', alt: alt_text, widths: '300, 400, 600, 800, 900', sizes: card_sizes, class: 'card-v10__img' }}
        {%- if settings.card_hover_image and img2 -%}
          {{ img2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: alt_text2, widths: '300, 400, 600, 800, 900', sizes: card_sizes, class: 'card-v10__img card-v10__img--alt' }}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="media sm-ratio-{{ ratio }}" data-label="{{ product.title | escape }}"></div>
    {%- endif -%}
  </a>
  {%- if force_badge != blank -%}
    {%- liquid
      case force_badge_style
        when 'dark'
          assign forced_class = 'badge'
        when 'soft'
          assign forced_class = 'badge badge--soft'
        else
          assign forced_class = 'badge badge--sale'
      endcase
    -%}
    <span class="{{ forced_class }}">{{ force_badge }}</span>
  {%- elsif product.available == false -%}
    <span class="badge badge--soft">Uitverkocht</span>
  {%- elsif on_sale and badge_sale != blank -%}
    <span class="badge badge--sale">-{{ save }}%</span>
  {%- elsif is_new and badge_new != blank -%}
    <span class="badge badge--soft">{{ badge_new }}</span>
  {%- endif -%}
  {%- if settings.show_quick_view -%}
    <a class="card-v10__quick" href="{{ product.url }}" aria-label="{{ settings.quick_view_label | default: 'Bekijk' | escape }}: {{ product.title | escape }}">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
    </a>
  {%- endif -%}
  </div>
  <div class="card-v10__info">
    <h3 class="product-card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if settings.show_product_type and product.type != blank -%}
      <p class="product-card__cat">{{ product.type }}</p>
    {%- endif -%}
    {%- if settings.show_price -%}
      <p class="product-card__price">
        {%- if on_sale -%}
          <span class="price-sale">{{ product.price | money }}</span>
          <s class="price-old">{{ product.compare_at_price | money }}</s>
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</article>
