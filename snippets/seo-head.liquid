{%- comment -%}
  SEO + AI-zoekmachines (Snoo Systems SEO-aanpak).
  Titel, beschrijving, Open Graph/Twitter en gestructureerde data (JSON-LD).
  Alle bedrijfsgegevens komen uit Thema-instellingen > Bedrijfsgegevens / Sociale media,
  zodat Google, ChatGPT en Perplexity overal dezelfde, kloppende gegevens zien.
  Eigen titels en beschrijvingen per product/collectie/pagina (Shopify: "Zoekmachinevermelding") winnen altijd.
{%- endcomment -%}
{%- liquid
  assign brand = 'Snoopy Mode'
  assign city = settings.seo_city | default: 'Rotterdam'
  assign tagline = settings.seo_tagline | default: 'Damesmode boetiek in Rotterdam'

  comment
    Titel: Shopify-titel + merk. De homepage krijgt een beschrijvende titel als die in Shopify leeg is.
  endcomment
  if request.page_type == 'index'
    if page_title == shop.name or page_title == blank
      assign seo_title = brand | append: ' | ' | append: tagline
    else
      assign seo_title = page_title
    endif
  else
    assign seo_title = page_title
    if current_tags
      assign tags_str = current_tags | join: ', '
      assign seo_title = seo_title | append: ' - ' | append: tags_str
    endif
    if current_page != 1
      assign seo_title = seo_title | append: ' - Pagina ' | append: current_page
    endif
    unless seo_title contains brand
      assign seo_title = seo_title | append: ' | ' | append: brand
    endunless
  endif

  comment
    Beschrijving (max ~155 tekens): eigen Shopify-tekst, anders een goede standaard per paginatype.
  endcomment
  assign seo_desc = page_description | strip_html | strip_newlines | strip
  if seo_desc == blank
    case request.page_type
      when 'index'
        assign seo_desc = settings.seo_home_description
      when 'product'
        assign price_str = product.price | money_without_trailing_zeros
        assign seo_desc = product.title | append: ' voor ' | append: price_str | append: ' bij Snoopy Mode, damesmode boetiek in ' | append: city | append: '. Gratis verzending vanaf 75 euro, 14 dagen bedenktijd.'
      when 'collection'
        assign seo_desc = 'Shop ' | append: collection.title | downcase | append: ' voor dames bij Snoopy Mode in ' | append: city | append: '. Elke week nieuwe items, persoonlijk advies en gratis verzending vanaf 75 euro.'
      else
        assign seo_desc = settings.seo_home_description
    endcase
  endif
  assign seo_desc = seo_desc | truncate: 160

  comment
    Deelafbeelding: product > collectie > pagina-afbeelding > standaard winkelfoto.
  endcomment
  if request.page_type == 'product' and product.featured_image
    assign og_image = product.featured_image | image_url: width: 1200
  elsif request.page_type == 'collection' and collection.featured_image
    assign og_image = collection.featured_image | image_url: width: 1200
  elsif page_image
    assign og_image = page_image | image_url: width: 1200
  elsif settings.share_image
    assign og_image = settings.share_image | image_url: width: 1200
  else
    assign og_image = 'sm-hero.jpg' | asset_url
  endif
  if og_image contains '//'
    unless og_image contains 'http'
      assign og_image = 'https:' | append: og_image
    endunless
  endif

  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif

  assign socials = ''
  assign social_keys = 'social_instagram,social_tiktok,social_facebook,social_pinterest' | split: ','
  for key in social_keys
    if settings[key] != blank
      assign socials = socials | append: settings[key] | append: '|'
    endif
  endfor
  assign socials = socials | split: '|'
  assign phone_digits = settings.company_phone | remove: ' ' | remove: '-'
  assign first_char = phone_digits | slice: 0
  if first_char == '0'
    assign phone_intl = '+31' | append: phone_digits | remove_first: '0'
  else
    assign phone_intl = phone_digits
  endif
  assign addr = settings.company_address | newline_to_br | split: '<br />'
  assign street = addr[1] | strip
  assign postcity = addr[2] | strip
  assign postcode = postcity | split: ' ' | slice: 0, 2 | join: ' '
  assign locality = postcity | remove_first: postcode | strip
  assign free_from = settings.free_shipping_threshold | default: 75
  assign ship_cost = settings.shipping_cost | default: 6.95
  assign free_cents = free_from | times: 100
-%}
<title>{{ seo_title | escape }}</title>
<meta name="description" content="{{ seo_desc | escape }}">
{%- if template.name == 'search' or template.name == 'cart' or template.name == 'password' or request.path contains '/account' %}
<meta name="robots" content="noindex, follow">
{%- endif %}

<meta property="og:site_name" content="{{ brand }}">
<meta property="og:locale" content="nl_NL">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:description" content="{{ seo_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:alt" content="{{ seo_title | escape }}">
{%- if request.page_type == 'product' %}
<meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code | default: 'EUR' }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_desc | escape }}">
<meta name="twitter:image" content="{{ og_image }}">

{%- comment -%} Het bedrijf (lokale kledingwinkel) staat op elke pagina: één consistente identiteit voor Google en AI. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ClothingStore",
  "@id": {{ shop.url | append: '/#store' | json }},
  "name": {{ brand | json }},
  "url": {{ shop.url | append: '/' | json }},
  {%- if settings.favicon != blank %}"logo": {{ settings.favicon | image_url: width: 512 | prepend: 'https:' | json }},{% endif %}
  "image": {{ og_image | json }},
  "description": {{ settings.seo_home_description | json }},
  {%- if settings.company_email != blank %}"email": {{ settings.company_email | json }},{% endif %}
  {%- if phone_intl != blank %}"telephone": {{ phone_intl | json }},{% endif %}
  {%- if street != blank %}
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ street | json }},
    "postalCode": {{ postcode | json }},
    "addressLocality": {{ locality | json }},
    "addressCountry": "NL"
  },
  {%- endif %}
  {%- if settings.company_kvk != blank %}"identifier": {"@type": "PropertyValue", "propertyID": "KVK", "value": {{ settings.company_kvk | json }}},{% endif %}
  {%- if settings.seo_founding_year != blank %}"foundingDate": {{ settings.seo_founding_year | json }},{% endif %}
  "priceRange": "€€",
  "currenciesAccepted": "EUR",
  "areaServed": ["NL", "BE"],
  "sameAs": {{ socials | json }}
}
</script>
{%- if request.page_type == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": {{ shop.url | append: '/#website' | json }},
  "name": {{ brand | json }},
  "url": {{ shop.url | append: '/' | json }},
  "inLanguage": "nl-NL",
  "publisher": {"@id": {{ shop.url | append: '/#store' | json }}},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif %}
{%- if request.page_type == 'product' %}
{%- assign pdesc = product.description | strip_html | strip_newlines | strip | truncate: 500 | default: seo_desc %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ canonical_url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  "description": {{ pdesc | json }},
  "image": [{%- for img in product.images limit: 6 -%}{{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
  {%- if product.type != blank %}"category": {{ product.type | json }},{% endif %}
  "brand": {"@type": "Brand", "name": {{ product.vendor | default: brand | json }}},
  {%- if product.selected_or_first_available_variant.sku != blank %}"sku": {{ product.selected_or_first_available_variant.sku | json }},{% endif %}
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
      "name": {{ v.title | json }},
      "url": {{ canonical_url | append: '?variant=' | append: v.id | json }},
      "price": {{ v.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | default: 'EUR' | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "seller": {"@id": {{ shop.url | append: '/#store' | json }}},
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {"@type": "MonetaryAmount", "value": {% if v.price >= free_cents %}0{% else %}{{ ship_cost | json }}{% endif %}, "currency": "EUR"},
        "shippingDestination": {"@type": "DefinedRegion", "addressCountry": "NL"},
        "deliveryTime": {"@type": "ShippingDeliveryTime",
          "handlingTime": {"@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY"},
          "transitTime": {"@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY"}}
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "NL",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 14,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif %}
{%- if request.page_type == 'product' or request.page_type == 'collection' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }}}
    {%- if collection %},{"@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }}}{% endif %}
    {%- if request.page_type == 'product' %},{"@type": "ListItem", "position": {% if collection %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ canonical_url | json }}}{% endif %}
  ]
}
</script>
{%- endif %}
