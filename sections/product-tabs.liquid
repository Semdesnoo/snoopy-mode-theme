{%- comment -%}
  Producttabs (v10, Rano-stijl): kop, tabs per collectie en een swipe-rij met pijlen.
  Zet een woord in de kop tussen [ ] voor schuine letters, bijv. "De nieuwste [favorieten]".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign limit = s.limit | default: 8
-%}
{%- capture sm_class -%}{%- render 'sm-section-class', s: s -%}{%- endcapture -%}

<section class="section ptabs {{ sm_class }}" data-tabs>
  <div class="container container--wide">
    <div class="section-head section-head--center reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="section-head__title">{{ s.heading | escape | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>{%- endif -%}
      {%- if s.subtext != blank -%}<p>{{ s.subtext }}</p>{%- endif -%}
    </div>
    <div class="ptabs__bar">
      {%- if section.blocks.size > 1 -%}
        <div class="ptabs__tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button type="button" role="tab" class="ptabs__tab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="panel-{{ block.id }}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="ptabs__arrows">
        <button type="button" class="ptabs__arrow" data-carousel-prev aria-label="Vorige producten"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><polyline points="15 6 9 12 15 18" /></svg></button>
        <button type="button" class="ptabs__arrow" data-carousel-next aria-label="Volgende producten"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><polyline points="9 6 15 12 9 18" /></svg></button>
      </div>
    </div>
  </div>
  {%- for block in section.blocks -%}
    {%- assign coll = block.settings.collection | default: collections.all -%}
    <div class="ptabs__panel" id="panel-{{ block.id }}" role="tabpanel" data-panel{% unless forloop.first %} hidden{% endunless %}>
      <div class="ptabs__track" data-carousel>
        {%- for product in coll.products limit: limit -%}
          <div class="ptabs__item">{% render 'product-card', product: product, sizes: '(max-width: 749px) 46vw, (max-width: 989px) 31vw, 24vw' %}</div>
        {%- else -%}
          <p class="ptabs__empty">Voeg producten toe aan deze collectie om ze hier te tonen.</p>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}
  {%- if s.link_label != blank -%}
    <div class="ptabs__more">
      <a class="btn btn--outline" href="{{ s.link_url | default: routes.all_products_collection_url }}">{{ s.link_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Producttabs",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Klein kopje erboven" },
    { "type": "text", "id": "heading", "label": "Kop", "info": "Zet een woord tussen [ ] voor schuine letters.", "default": "De nieuwste [favorieten]" },
    { "type": "textarea", "id": "subtext", "label": "Tekst eronder" },
    { "type": "range", "id": "limit", "label": "Producten per tab", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "text", "id": "link_label", "label": "Tekst op de knop onderaan", "default": "Bekijk alles" },
    { "type": "url", "id": "link_url", "label": "Waar die knop naartoe gaat" },
    { "type": "select", "id": "bg", "label": "Achtergrond", "options": [
      { "value": "default", "label": "Standaard" }, { "value": "alt", "label": "Zachte zandtint" }, { "value": "white", "label": "Wit" }
    ], "default": "default" },
    { "type": "checkbox", "id": "hide_mobile", "label": "Deze sectie verbergen op mobiel", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Deze sectie verbergen op laptop", "default": false }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Naam van de tab", "default": "Nieuw binnen" },
        { "type": "collection", "id": "collection", "label": "Collectie" }
      ]
    }
  ],
  "presets": [{ "name": "Producttabs", "blocks": [{ "type": "tab" }] }]
}
{% endschema %}
