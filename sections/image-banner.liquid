{%- comment -%}
  Fotobanner — een brede foto met tekst eroverheen. Ideaal voor een actie of
  een nieuwe collectie. Foto, hoogte en uitlijning zijn apart in te stellen
  voor laptop en mobiel.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign overlay = s.overlay_strength | default: 30 | times: 0.01
  assign ratio = s.image_ratio | default: 'wide'
  assign ratio_mobile = s.image_ratio_mobile | default: 'portrait'
-%}
{%- capture sm_class -%}{%- render 'sm-section-class', s: s -%}{%- endcapture -%}

{%- style -%}
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .sm-banner__media { aspect-ratio: {% case ratio_mobile %}{% when 'square' %}1 / 1{% when 'portrait' %}3 / 4{% when 'tall' %}2 / 3{% when 'landscape' %}4 / 3{% else %}16 / 9{% endcase %} !important; }
  }
{%- endstyle -%}

<section class="{% unless s.full_width %}container container--wide{% endunless %} {{ sm_class }}" style="--sm-banner-overlay: {{ overlay }};">
  <div class="sm-banner reveal">
    {%- assign banner_wrapper = 'sm-banner__media media sm-ratio-' | append: ratio -%}
    {%- render 'sm-photo',
      image: s.image,
      image_mobile: s.image_mobile,
      key: 'banner',
      alt: s.image_alt | default: s.heading,
      label: s.placeholder_label,
      wrapper_class: banner_wrapper,
      loading: 'lazy',
      widths: '600, 900, 1200, 1600, 2000',
      sizes: '100vw' -%}

    {%- if s.show_overlay -%}<div class="sm-banner__overlay"></div>{%- endif -%}

    <div class="sm-banner__content sm-banner--{{ s.text_position | default: 'center' }} sm-align-{{ s.align | default: 'left' }} sm-align-mobile-{{ s.align_mobile | default: 'center' }}">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
      {%- if s.button_1_label != blank or s.button_2_label != blank -%}
        <div class="sm-banner__actions">
          {%- if s.button_1_label != blank -%}
            <a class="btn btn--light" href="{{ s.button_1_link | default: '#' }}">{{ s.button_1_label }}</a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a class="btn btn--outline-light" href="{{ s.button_2_link | default: '#' }}">{{ s.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fotobanner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Foto" },
    { "type": "image_picker", "id": "image", "label": "Foto — laptop & tablet" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Foto — mobiel",
      "info": "Leeg laten = dezelfde foto als op laptop."
    },
    { "type": "text", "id": "image_alt", "label": "Omschrijving van de foto" },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Tekst zolang er nog geen foto is",
      "default": "Nieuwe collectie"
    },

    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "eyebrow", "label": "Klein kopje erboven" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Nieuw deze week" },
    { "type": "textarea", "id": "text", "label": "Tekst eronder" },

    { "type": "header", "content": "Knop 1" },
    { "type": "text", "id": "button_1_label", "label": "Tekst op de knop", "default": "Bekijken" },
    { "type": "url", "id": "button_1_link", "label": "Waar de knop naartoe gaat" },

    { "type": "header", "content": "Knop 2" },
    { "type": "text", "id": "button_2_label", "label": "Tekst op de knop" },
    { "type": "url", "id": "button_2_link", "label": "Waar de knop naartoe gaat" },

    { "type": "header", "content": "Weergave op laptop & tablet" },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Over de volle schermbreedte",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Vorm van de foto",
      "options": [
        { "value": "wide", "label": "Breed (16:9)" },
        { "value": "landscape", "label": "Liggend (4:3)" },
        { "value": "square", "label": "Vierkant" }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Tekst staat",
      "options": [
        { "value": "top", "label": "Bovenaan" },
        { "value": "center", "label": "In het midden" },
        { "value": "bottom", "label": "Onderaan" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Tekst uitlijnen",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Donkerte over de foto",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    { "type": "checkbox", "id": "show_overlay", "label": "Donkere laag tonen", "default": true },

    { "type": "header", "content": "Weergave op mobiel" },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Vorm van de foto",
      "options": [
        { "value": "portrait", "label": "Staand (3:4)" },
        { "value": "tall", "label": "Extra staand (2:3)" },
        { "value": "square", "label": "Vierkant" },
        { "value": "wide", "label": "Breed (16:9)" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "align_mobile",
      "label": "Tekst uitlijnen",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Ruimte" },
    {
      "type": "select",
      "id": "space",
      "label": "Ruimte boven en onder (laptop)",
      "options": [
        { "value": "default", "label": "Standaard" },
        { "value": "none", "label": "Geen" },
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "large", "label": "Groot" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "space_mobile",
      "label": "Ruimte boven en onder (mobiel)",
      "options": [
        { "value": "default", "label": "Standaard" },
        { "value": "none", "label": "Geen" },
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "large", "label": "Groot" }
      ],
      "default": "none"
    },

    { "type": "header", "content": "Zichtbaarheid" },
    { "type": "checkbox", "id": "hide_mobile", "label": "Deze sectie verbergen op mobiel", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Deze sectie verbergen op laptop", "default": false }
  ],
  "presets": [
    { "name": "Fotobanner" }
  ]
}
{% endschema %}
