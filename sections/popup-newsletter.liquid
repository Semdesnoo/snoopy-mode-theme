{%- comment -%}
  Nieuwsbrief-pop-up — het venster met (bijvoorbeeld) een welkomstkorting.
  Aan/uit, tekst, foto (laptop én mobiel), moment van verschijnen en hoe vaak
  hij terugkomt: allemaal in te stellen in de Thema-editor.
  Inschrijvingen komen binnen bij Shopify → Klanten, met de tag "newsletter".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign show_here = true

  unless s.enabled
    assign show_here = false
  endunless

  if s.pages == 'home' and request.page_type != 'index'
    assign show_here = false
  endif
-%}

{%- if show_here -%}
  <div
    class="sm-popup{% if s.style == 'corner' %} sm-popup--corner{% endif %}{% if s.hide_mobile %} sm-hide-mobile{% endif %}{% if s.hide_desktop %} sm-hide-desktop{% endif %}"
    data-sm-popup="nieuwsbrief-{{ section.id }}"
    data-trigger="{{ s.trigger }}"
    data-delay="{{ s.delay }}"
    data-scroll="{{ s.scroll_percent }}"
    data-days="{{ s.remember_days }}"
    data-editor="{% if request.design_mode %}true{% else %}false{% endif %}"
    role="dialog"
    aria-modal="true"
    aria-label="{{ s.heading | default: 'Nieuwsbrief' | escape }}"
    aria-hidden="true"
  >
    <div class="sm-popup__overlay" data-sm-popup-close></div>

    <div class="sm-popup__dialog{% if s.image != blank or s.placeholder_label != blank %} sm-popup__dialog--with-media{% else %} sm-popup__dialog--narrow{% endif %}{% if s.hide_image_mobile %} sm-popup__dialog--hide-media-mobile{% endif %}">
      <button class="sm-popup__close" type="button" data-sm-popup-close aria-label="{{ s.close_label | default: 'Sluiten' | escape }}">&times;</button>

      {%- if s.image != blank or s.placeholder_label != blank -%}
        <div class="sm-popup__media">
          {%- assign _alt_image_alt = s.image_alt | default: s.heading -%}
          {%- render 'sm-photo',
            image: s.image,
            image_mobile: s.image_mobile,
            key: 'popup-nieuwsbrief',
            alt: _alt_image_alt,
            label: s.placeholder_label,
            wrapper_class: 'media',
            loading: 'lazy',
            widths: '400, 600, 800, 1000',
            sizes: '(max-width: 749px) 100vw, 440px' -%}
        </div>
      {%- endif -%}

      <div class="sm-popup__body sm-align-{{ s.align | default: 'left' }}">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading | escape | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}

        {%- form 'customer', class: 'sm-popup__form', novalidate: 'novalidate' -%}
          {%- if form.posted_successfully? -%}
            <p class="sm-popup__thanks" data-sm-popup-success>{{ s.success_text }}</p>
            {%- if s.discount_code != blank -%}
              <span class="sm-popup__code">{{ s.discount_code }}</span>
            {%- endif -%}
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="popup-email-{{ section.id }}">{{ s.field_placeholder | default: 'Je e-mailadres' }}</label>
            <input id="popup-email-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ s.field_placeholder | default: 'Je e-mailadres' | escape }}" autocomplete="email" required>
            <button class="btn" type="submit">{{ s.button_label | default: 'Ja, ik doe mee' }}</button>
          {%- endif -%}
        {%- endform -%}

        {%- if s.note != blank -%}<p class="sm-popup__note">{{ s.note }}</p>{%- endif -%}
        {%- if s.dismiss_label != blank -%}
          <button class="sm-popup__dismiss" type="button" data-sm-popup-close>{{ s.dismiss_label }}</button>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Pop-up — nieuwsbrief",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Pop-up aanzetten",
      "info": "Zet dit uit en de pop-up verdwijnt volledig van de website.",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "In de editor is de pop-up altijd zichtbaar zodat je hem kunt bewerken. Bezoekers zien hem pas volgens de regels bij 'Wanneer verschijnt hij?'."
    },

    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "eyebrow", "label": "Klein kopje erboven", "default": "Welkom bij Snoopy Mode" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "€10 korting op je eerste bestelling" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Schrijf je in voor onze nieuwsbrief en ontvang als eerste nieuwe collecties, stijltips en aanbiedingen."
    },
    { "type": "text", "id": "field_placeholder", "label": "Tekst in het invoerveld", "default": "Je e-mailadres" },
    { "type": "text", "id": "button_label", "label": "Tekst op de knop", "default": "Ja, ik doe mee" },
    { "type": "text", "id": "success_text", "label": "Tekst na inschrijving", "default": "Welkom bij de club! Gebruik deze code bij je eerste bestelling:" },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Kortingscode die je daarna toont",
      "info": "Maak de code eerst aan in Shopify → Kortingen. Leeg laten = geen code tonen.",
      "default": "WELKOM10"
    },
    { "type": "text", "id": "note", "label": "Kleine tekst onderaan", "default": "Je kunt je op elk moment uitschrijven." },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Tekst van het 'nee bedankt'-linkje",
      "info": "Leeg laten = alleen het kruisje om te sluiten.",
      "default": "Nee, bedankt"
    },

    { "type": "header", "content": "Foto" },
    { "type": "image_picker", "id": "image", "label": "Foto — laptop & tablet" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Foto — mobiel",
      "info": "Leeg laten = dezelfde foto als op laptop."
    },
    { "type": "text", "id": "image_alt", "label": "Omschrijving van de foto" },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Tekst zolang er nog geen foto is",
      "info": "Leeg laten = de pop-up wordt smal, zonder fotovlak.",
      "default": "Nieuwe collectie"
    },
    {
      "type": "checkbox",
      "id": "hide_image_mobile",
      "label": "Foto verbergen op mobiel",
      "info": "Handig als de pop-up op een telefoon anders te hoog wordt.",
      "default": false
    },

    { "type": "header", "content": "Wanneer verschijnt hij?" },
    {
      "type": "select",
      "id": "trigger",
      "label": "Moment",
      "options": [
        { "value": "delay", "label": "Na een aantal seconden" },
        { "value": "scroll", "label": "Als de bezoeker een stuk gescrold heeft" },
        { "value": "exit", "label": "Als de bezoeker weg lijkt te gaan" },
        { "value": "immediate", "label": "Meteen" }
      ],
      "default": "delay"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Aantal seconden",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "range",
      "id": "scroll_percent",
      "label": "Vanaf hoeveel procent van de pagina",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "remember_days",
      "label": "Daarna hoeveel dagen niet meer tonen",
      "info": "0 = bij elk bezoek opnieuw tonen (meestal irritant).",
      "min": 0,
      "max": 90,
      "step": 1,
      "default": 14
    },

    { "type": "header", "content": "Weergave" },
    {
      "type": "select",
      "id": "style",
      "label": "Vorm",
      "options": [
        { "value": "modal", "label": "Groot venster in het midden" },
        { "value": "corner", "label": "Klein kaartje rechtsonder" }
      ],
      "default": "modal"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Tekst uitlijnen",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "pages",
      "label": "Op welke pagina's?",
      "options": [
        { "value": "all", "label": "Op de hele website" },
        { "value": "home", "label": "Alleen op de homepage" }
      ],
      "default": "all"
    },
    { "type": "checkbox", "id": "hide_mobile", "label": "Niet tonen op mobiel", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Niet tonen op laptop", "default": false },
    { "type": "text", "id": "close_label", "label": "Voorleestekst sluitknop", "default": "Sluiten" }
  ]
}
{% endschema %}
