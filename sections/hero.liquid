{%- comment -%}
  Hero — de grote sfeerfoto bovenaan de homepage.
  Alles is instelbaar in de Thema-editor, met aparte keuzes voor laptop en mobiel:
  foto, hoogte, donkerte van de laag over de foto, kop/tekst en de knoppen.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign overlay = s.overlay_strength | default: 28 | times: 0.01
  assign overlay_mobile = s.overlay_strength_mobile | default: 32 | times: 0.01

  assign heading_mobile = s.heading_mobile | default: s.heading
  assign text_mobile = s.text_mobile | default: s.text
-%}

{%- capture sm_class -%}{%- render 'sm-section-class', s: s -%}{%- endcapture -%}

<section
  class="hero sm-hero-{{ s.height | default: 'tall' }} sm-hero-mobile-{{ s.height_mobile | default: 'tall' }} {{ sm_class }}"
  style="--sm-hero-overlay: {{ overlay }}; --sm-hero-overlay-mobile: {{ overlay_mobile }};"
>
  {%- assign _alt_image_alt = s.image_alt | default: s.heading -%}
  {%- render 'sm-photo',
    image: s.image,
    image_mobile: s.image_mobile,
    key: 'hero',
    alt: _alt_image_alt,
    label: s.placeholder_label,
    wrapper_class: 'media media--wide',
    img_class: 'hero__img',
    loading: 'eager',
    fetchpriority: 'high',
    widths: '600, 800, 1200, 1600, 2000',
    sizes: '100vw' -%}

  {%- if s.show_overlay -%}<div class="hero__overlay"></div>{%- endif -%}

  <div class="hero__content sm-hero-pos-{{ s.text_position | default: 'bottom' }} sm-hero-pos-mobile-{{ s.text_position_mobile | default: 'bottom' }} sm-align-{{ s.align | default: 'left' }} sm-align-mobile-{{ s.align_mobile | default: 'left' }}">
    <div class="container container--wide">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow reveal">{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- if s.heading != blank or heading_mobile != blank -%}
        {%- if s.heading == heading_mobile -%}
          <h1 class="display-1 hero__title reveal" data-delay="1">{{ s.heading | escape | replace: '[', '<em>' | replace: ']', '</em>' }}</h1>
        {%- else -%}
          <h1 class="display-1 hero__title reveal sm-only-desktop" data-delay="1">{{ s.heading | escape | replace: '[', '<em>' | replace: ']', '</em>' }}</h1>
          <h1 class="display-1 hero__title reveal sm-only-mobile" data-delay="1">{{ heading_mobile | escape | replace: '[', '<em>' | replace: ']', '</em>' }}</h1>
        {%- endif -%}
      {%- endif -%}

      {%- if s.text != blank or text_mobile != blank -%}
        {%- if s.text == text_mobile -%}
          <p class="lead hero__text reveal" data-delay="2">{{ s.text }}</p>
        {%- else -%}
          <p class="lead hero__text reveal sm-only-desktop" data-delay="2">{{ s.text }}</p>
          <p class="lead hero__text reveal sm-only-mobile" data-delay="2">{{ text_mobile }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if s.button_1_label != blank or s.button_2_label != blank -%}
        <div class="hero__actions reveal" data-delay="3">
          {%- if s.button_1_label != blank -%}
            <a class="btn btn--light" href="{{ s.button_1_link | default: routes.all_products_collection_url }}">{{ s.button_1_label }}</a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a class="btn btn--outline-light" href="{{ s.button_2_link | default: '#' }}">{{ s.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero (grote foto)",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Foto's" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto — laptop & tablet",
      "info": "Liggende foto, 2400 x 1200 pixels. Houd het bestand onder 400 KB — dit is de zwaarste foto van je site."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Foto — mobiel",
      "info": "Staande foto, 1200 x 2100 pixels. Leeg laten = dezelfde foto als op laptop."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Omschrijving van de foto",
      "info": "Voor blinden en slechtzienden, en goed voor Google.",
      "default": "Vrouw in linnen zomeroutfit in zacht daglicht"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Tekst zolang er nog geen foto is",
      "default": "Hero · sfeerbeeld lente/zomer"
    },

    { "type": "header", "content": "Tekst" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Klein kopje erboven"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Grote kop",
      "default": "Jouw favoriete winkel, nu online"
    },
    {
      "type": "text",
      "id": "heading_mobile",
      "label": "Grote kop — mobiel (optioneel)",
      "info": "Leeg laten = dezelfde kop als op laptop. Handig voor een kortere zin op de telefoon."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst eronder",
      "default": "Met wekelijks de nieuwste collectie."
    },
    {
      "type": "textarea",
      "id": "text_mobile",
      "label": "Tekst eronder — mobiel (optioneel)",
      "info": "Leeg laten = dezelfde tekst als op laptop."
    },

    { "type": "header", "content": "Knop 1" },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Tekst op de knop",
      "default": "Shop de collectie"
    },
    { "type": "url", "id": "button_1_link", "label": "Waar de knop naartoe gaat" },

    { "type": "header", "content": "Knop 2" },
    { "type": "text", "id": "button_2_label", "label": "Tekst op de knop" },
    { "type": "url", "id": "button_2_link", "label": "Waar de knop naartoe gaat" },

    { "type": "header", "content": "Weergave op laptop & tablet" },
    {
      "type": "select",
      "id": "height",
      "label": "Hoogte",
      "options": [
        { "value": "short", "label": "Laag" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "tall", "label": "Hoog (standaard)" },
        { "value": "full", "label": "Volledig scherm" }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Tekst staat",
      "options": [
        { "value": "top", "label": "Bovenaan" },
        { "value": "center", "label": "In het midden" },
        { "value": "bottom", "label": "Onderaan (standaard)" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Tekst uitlijnen",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Donkerte over de foto",
      "info": "Hoger = beter leesbare tekst, maar de foto wordt donkerder.",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 30
    },

    { "type": "header", "content": "Weergave op mobiel" },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Hoogte",
      "options": [
        { "value": "short", "label": "Laag" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "tall", "label": "Hoog (standaard)" },
        { "value": "full", "label": "Volledig scherm" }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "text_position_mobile",
      "label": "Tekst staat",
      "options": [
        { "value": "top", "label": "Bovenaan" },
        { "value": "center", "label": "In het midden" },
        { "value": "bottom", "label": "Onderaan (standaard)" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "align_mobile",
      "label": "Tekst uitlijnen",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_strength_mobile",
      "label": "Donkerte over de foto",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35
    },

    { "type": "header", "content": "Zichtbaarheid" },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Donkere laag over de foto tonen",
      "default": true
    },
    { "type": "checkbox", "id": "hide_mobile", "label": "Deze sectie verbergen op mobiel", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Deze sectie verbergen op laptop", "default": false }
  ],
  "presets": [
    { "name": "Hero (grote foto)" }
  ]
}
{% endschema %}
