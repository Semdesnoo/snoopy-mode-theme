{%- comment -%}
  Footer (v10, Rano-opbouw): bovenin merk + nieuwsbrief, daaronder vier linkkolommen
  (Shop, Klantenservice, Snoopy Mode, Bezoek de winkel), onderin betaalmethoden en juridische links.
  Gekoppelde Shopify-menu's winnen; zonder menu tonen we alleen links die echt bestaan.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign brand_name = s.brand_text | default: shop.name
  assign footer_email = s.email | default: settings.company_email | default: shop.email
  assign footer_phone = s.phone | default: settings.company_phone
  assign wa_phone = footer_phone | remove: ' ' | remove: '-' | remove_first: '0'
  assign ig_url = s.social_instagram | default: settings.social_instagram
  assign tt_url = s.social_tiktok | default: settings.social_tiktok
  assign fb_url = s.social_facebook | default: settings.social_facebook
  assign pi_url = s.social_pinterest | default: settings.social_pinterest
  assign addr_lines = settings.company_address | newline_to_br | split: '<br />'
  assign maps_q = settings.company_address | strip_newlines | replace: 'Snoopy Mode V.O.F.', 'Snoopy Mode' | url_encode
  assign year = 'now' | date: '%Y'
  assign copyright = s.copyright_text | default: '© {jaar} Snoopy Mode'
  assign copyright = copyright | replace: '{jaar}', year | replace: '{winkel}', shop.name
-%}

<footer class="site-footer footer-v10">
  <div class="container container--wide">
    <div class="footer-v10__top">
      <div class="footer-v10__brand">
        <span class="brand">{{ brand_name }}</span>
        {%- if s.brand_description != blank -%}<p>{{ s.brand_description }}</p>{%- endif -%}
        <div class="footer-social">
          {%- if ig_url != blank -%}<a href="{{ ig_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg></a>{%- endif -%}
          {%- if tt_url != blank -%}<a href="{{ tt_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op TikTok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 4v9.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 7a4 4 0 0 0 4 3"/></svg></a>{%- endif -%}
          {%- if fb_url != blank -%}<a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 8h2V5h-2a3 3 0 0 0-3 3v2H9v3h2v6h3v-6h2.2l.4-3H14V8.5c0-.3.2-.5.5-.5z"/></svg></a>{%- endif -%}
          {%- if pi_url != blank -%}<a href="{{ pi_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op Pinterest"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M10 18l1.4-5.4M9.6 10.4a2.6 2.6 0 1 1 4.8 1.5c-.4 1.6-2.3 2-3 .8"/></svg></a>{%- endif -%}
        </div>
      </div>
      {%- if s.show_newsletter -%}
        <div class="footer-v10__news">
          <h2 class="footer-v10__h">{{ s.news_heading }}</h2>
          {%- if s.news_text != blank -%}<p>{{ s.news_text }}</p>{%- endif -%}
          {%- form 'customer', id: 'footer-newsletter', class: 'newsletter-form' -%}
            {%- if form.posted_successfully? -%}
              <p class="newsletter__thanks" role="status">Bedankt voor je aanmelding!</p>
            {%- else -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="footer-news-email">Je e-mailadres</label>
              <input id="footer-news-email" type="email" name="contact[email]" placeholder="Je e-mailadres" autocomplete="email" required>
              <button class="btn" type="submit">Aanmelden</button>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <nav class="footer-v10__cols" aria-label="Footer">
      {%- for n in (1..3) -%}
        {%- liquid
          assign heading_key = 'footer_heading_' | append: n
          assign menu_key = 'footer_menu_' | append: n
          assign col_heading = s[heading_key]
          assign col_menu = s[menu_key]
        -%}
        <div class="footer-col">
          <h3>{{ col_heading }}</h3>
          <ul>
            {%- if linklists[col_menu].links.size > 0 -%}
              {%- for link in linklists[col_menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            {%- else -%}
              {%- case n -%}
                {%- when 1 -%}
                  {%- assign shop_handles = 'nieuw-binnen,onze-bestseller,sale,jassen-blazers,blazers,truien-vesten,blouses-tops,tops,broeken,broeken-1,rokken,jurken,tassen,schoenen' | split: ',' -%}
                  {%- for h in shop_handles -%}
                    {%- assign c = collections[h] -%}
                    {%- if c != blank and c.products_count > 0 -%}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{%- endif -%}
                  {%- endfor -%}
                  <li><a href="{{ routes.all_products_collection_url }}">Alles bekijken</a></li>
                {%- when 2 -%}
                  {%- assign service_handles = 'contact,veelgestelde-vragen,verzending-retour,maattabel,betaalmethoden' | split: ',' -%}
                  {%- for h in service_handles -%}
                    {%- assign sp = pages[h] -%}
                    {%- if sp != blank -%}<li><a href="{{ sp.url }}">{{ sp.title }}</a></li>{%- endif -%}
                  {%- endfor -%}
                  <li><a href="{{ routes.account_url }}">Mijn account &amp; bestellingen</a></li>
                {%- when 3 -%}
                  {%- assign about_page = pages['over-ons'] -%}
                  {%- if about_page != blank -%}<li><a href="{{ about_page.url }}">Ons verhaal</a></li>{%- endif -%}
                  {%- if ig_url != blank -%}<li><a href="{{ ig_url }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>{%- endif -%}
                  {%- if tt_url != blank -%}<li><a href="{{ tt_url }}" target="_blank" rel="noopener noreferrer">TikTok</a></li>{%- endif -%}
                  {%- if fb_url != blank -%}<li><a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer">Facebook</a></li>{%- endif -%}
                  {%- if wa_phone != blank -%}<li><a href="https://wa.me/31{{ wa_phone }}" target="_blank" rel="noopener noreferrer">Bestellen via WhatsApp</a></li>{%- endif -%}
              {%- endcase -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
      {%- if s.show_store -%}
        <div class="footer-col">
          <h3>{{ s.store_heading }}</h3>
          <address class="footer-v10__store">
            {%- for line in addr_lines offset: 1 -%}<span>{{ line | strip }}</span>{%- endfor -%}
            {%- if footer_phone != blank -%}<a href="tel:{{ footer_phone | remove: ' ' }}">{{ footer_phone }}</a>{%- endif -%}
            {%- if footer_email != blank -%}<a href="mailto:{{ footer_email }}">{{ footer_email }}</a>{%- endif -%}
            <a class="footer-v10__route" href="https://www.google.com/maps/search/?api=1&amp;query={{ maps_q }}" target="_blank" rel="noopener noreferrer">Plan je route</a>
          </address>
        </div>
      {%- endif -%}
    </nav>

    <div class="footer-bottom footer-v10__bottom">
      <span>{{ copyright }}{% if settings.company_kvk != blank %} &middot; KVK {{ settings.company_kvk }}{% endif %}</span>
      {%- if s.show_payments and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer-v10__pay" aria-label="Betaalmethoden">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="legal-links">
        {%- if linklists[s.footer_legal_menu].links.size > 0 -%}
          {%- for link in linklists[s.footer_legal_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          {%- assign legal_handles = 'algemene-voorwaarden,privacybeleid,cookies' | split: ',' -%}
          {%- for handle in legal_handles -%}
            {%- assign legal_page = pages[handle] -%}
            {%- if legal_page != blank -%}<a href="{{ legal_page.url }}">{{ legal_page.title }}</a>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Logo & naam" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo — laptop & tablet",
      "info": "Bij voorkeur een lichte versie van je logo (de footer is donker)."
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Logo — mobiel",
      "info": "Leeg laten = hetzelfde logo als op laptop."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Breedte logo",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Winkelnaam in tekst",
      "info": "Wordt gebruikt zolang je geen logo hebt geüpload.",
      "default": "Snoopy Mode"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Korte tekst eronder",
      "default": "Damesmode boetiek in Rotterdam sinds 2002. Elke week nieuwe collectie, met zorg uitgekozen door Marjolein en Monique."
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mailadres",
      "info": "Leeg laten = het adres uit Thema-instellingen → Bedrijfsgegevens."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefoonnummer",
      "info": "Leeg laten = niet tonen."
    },

    { "type": "header", "content": "Sociale media" },
    {
      "type": "paragraph",
      "content": "Leeg laten = de link uit Thema-instellingen → Sociale media. Staat daar ook niets, dan verdwijnt het icoon."
    },
    { "type": "url", "id": "social_instagram", "label": "Instagram-URL" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok-URL" },
    { "type": "url", "id": "social_facebook", "label": "Facebook-URL" },
    { "type": "url", "id": "social_pinterest", "label": "Pinterest-URL" },

    { "type": "header", "content": "Linkkolom 1" },
    {
      "type": "text",
      "id": "footer_heading_1",
      "label": "Kop",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Menu",
      "info": "Maak een menu in Shopify → Content → Menu's en kies het hier. Leeg = we tonen automatisch je collecties."
    },

    { "type": "header", "content": "Linkkolom 2" },
    {
      "type": "text",
      "id": "footer_heading_2",
      "label": "Kop",
      "default": "Klantenservice"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Menu",
      "info": "Leeg = de standaard klantenservice-links."
    },

    { "type": "header", "content": "Linkkolom 3" },
    {
      "type": "text",
      "id": "footer_heading_3",
      "label": "Kop",
      "default": "Snoopy Mode"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Menu",
      "info": "Leeg = een standaardlink naar 'Ons verhaal'."
    },

    { "type": "header", "content": "Onderbalk" },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright-tekst",
      "info": "Gebruik {jaar} voor het huidige jaartal.",
      "default": "© {jaar} Snoopy Mode"
    },
    {
      "type": "link_list",
      "id": "footer_legal_menu",
      "label": "Juridische links",
      "info": "Leeg = voorwaarden, privacybeleid en cookies."
    },
    { "type": "header", "content": "Nieuwsbrief in de footer" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Nieuwsbrief tonen", "default": true },
    { "type": "text", "id": "news_heading", "label": "Kop", "default": "Blijf op de hoogte" },
    { "type": "text", "id": "news_text", "label": "Tekst", "default": "Als eerste weten wat er nieuw binnen is, plus stijltips en acties." },
    { "type": "header", "content": "Bezoek de winkel" },
    { "type": "checkbox", "id": "show_store", "label": "Kolom met adres en route tonen", "info": "Adres, telefoon en e-mail komen uit Thema-instellingen > Bedrijfsgegevens.", "default": true },
    { "type": "text", "id": "store_heading", "label": "Kop", "default": "Bezoek de winkel" },
    { "type": "checkbox", "id": "show_payments", "label": "Betaalmethoden tonen", "default": true }
  ]
}
{% endschema %}
