{%- comment -%}
  Footer — logo/naam, korte tekst, sociale links, drie linkkolommen en de onderbalk.
  Alle teksten, links en het logo zijn instelbaar in de Thema-editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign brand_name = s.brand_text | default: shop.name
  assign footer_email = s.email | default: settings.company_email | default: shop.email

  assign ig_url = s.social_instagram | default: settings.social_instagram
  assign tt_url = s.social_tiktok | default: settings.social_tiktok
  assign fb_url = s.social_facebook | default: settings.social_facebook
  assign pi_url = s.social_pinterest | default: settings.social_pinterest
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .footer-brand .brand__logo {
    --sm-footer-logo-w: {{ s.logo_width | default: 160 }}px;
  }
{%- endstyle -%}

<footer class="site-footer">
  <div class="container container--wide">
    <div class="footer-main">
      <!-- Brand-kolom -->
      <div class="footer-brand">
        {%- if s.logo != blank -%}
          <span class="brand">
            {%- render 'sm-picture',
              image: s.logo,
              image_mobile: s.logo_mobile,
              alt: brand_name,
              class: 'brand__logo',
              loading: 'lazy',
              widths: '120, 180, 240, 360',
              sizes: '160px' -%}
          </span>
        {%- else -%}
          <span class="brand">{{ brand_name }}</span>
        {%- endif -%}

        {% if s.brand_description != blank %}
          <p>{{ s.brand_description }}</p>
        {% endif %}

        {% if footer_email != blank %}
          <a class="footer-email" href="mailto:{{ footer_email }}">{{ footer_email }}</a>
        {% endif %}

        {% if s.phone != blank %}
          <a class="footer-email" href="tel:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a>
        {% endif %}

        <div class="footer-social">
          {% if ig_url != blank %}
            <a href="{{ ig_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>
            </a>
          {% endif %}
          {% if tt_url != blank %}
            <a href="{{ tt_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op TikTok">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 4v9.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 7a4 4 0 0 0 4 3"/></svg>
            </a>
          {% endif %}
          {% if fb_url != blank %}
            <a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op Facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 8h2V5h-2a3 3 0 0 0-3 3v2H9v3h2v6h3v-6h2.2l.4-3H14V8.5c0-.3.2-.5.5-.5z"/></svg>
            </a>
          {% endif %}
          {% if pi_url != blank %}
            <a href="{{ pi_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ brand_name }} op Pinterest">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M10 18l1.4-5.4M9.6 10.4a2.6 2.6 0 1 1 4.8 1.5c-.4 1.6-2.3 2-3 .8"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      {% assign footer_menus = '1,2,3' | split: ',' %}
      {% for n in footer_menus %}
        {% liquid
          assign heading_key = 'footer_heading_' | append: n
          assign menu_key = 'footer_menu_' | append: n
          assign col_heading = s[heading_key]
          assign col_menu = s[menu_key]
        %}
        <div class="footer-col">
          {% if col_heading != blank %}
            <h3>{{ col_heading }}</h3>
          {% endif %}
          {% if linklists[col_menu].links.size > 0 %}
            <ul>
              {% for link in linklists[col_menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            {%- comment -%} Nog geen eigen menu gekoppeld: dit staat er zolang alvast in. {%- endcomment -%}
            <ul>
              {% case n %}
                {% when '1' %}
                  {%- assign shown = 0 -%}
                  {%- for collection in collections limit: 8 -%}
                    {%- unless collection.handle == 'frontpage' or collection.handle == 'home-page' -%}
                      {%- if shown < 6 -%}
                        <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
                        {%- assign shown = shown | plus: 1 -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endfor -%}
                {% when '2' %}
                  {%- comment -%}
                    Alleen tonen wat écht bestaat: zo staat er nooit een link in
                    de footer die op een "pagina niet gevonden" uitkomt.
                  {%- endcomment -%}
                  {%- assign service_handles = 'verzending-retour,maattabel,veelgestelde-vragen,contact,betaalmethoden' | split: ',' -%}
                  {%- for handle in service_handles -%}
                    {%- assign service_page = pages[handle] -%}
                    {%- if service_page != blank -%}
                      <li><a href="{{ service_page.url }}">{{ service_page.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {% when '3' %}
                  {%- assign about_page = pages['over-ons'] -%}
                  {%- if about_page != blank -%}
                    <li><a href="{{ about_page.url }}">{{ about_page.title }}</a></li>
                  {%- endif -%}
              {% endcase %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <!-- Onderbalk -->
    <div class="footer-bottom">
      {%- liquid
        assign year = 'now' | date: '%Y'
        assign copyright = s.copyright_text | default: '© {jaar} Snoopy Mode'
        assign copyright = copyright | replace: '{jaar}', year | replace: '{winkel}', shop.name
      -%}
      <span>{{ copyright }}</span>
      <div class="legal-links">
        {% if linklists[s.footer_legal_menu].links.size > 0 %}
          {% for link in linklists[s.footer_legal_menu].links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          {%- assign legal_handles = 'algemene-voorwaarden,privacybeleid,cookies' | split: ',' -%}
          {%- for handle in legal_handles -%}
            {%- assign legal_page = pages[handle] -%}
            {%- if legal_page != blank -%}
              <a href="{{ legal_page.url }}">{{ legal_page.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Logo & naam" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo — laptop & tablet",
      "info": "Bij voorkeur een lichte versie van je logo (de footer is donker)."
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Logo — mobiel",
      "info": "Leeg laten = hetzelfde logo als op laptop."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Breedte logo",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Winkelnaam in tekst",
      "info": "Wordt gebruikt zolang je geen logo hebt geüpload.",
      "default": "SNOOPY MODE"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Korte tekst eronder",
      "default": "Tijdloze mode voor de vrouw van nu — met zorg voor je uitgekozen."
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mailadres",
      "info": "Leeg laten = het adres uit Thema-instellingen → Bedrijfsgegevens."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefoonnummer",
      "info": "Leeg laten = niet tonen."
    },

    { "type": "header", "content": "Sociale media" },
    {
      "type": "paragraph",
      "content": "Leeg laten = de link uit Thema-instellingen → Sociale media. Staat daar ook niets, dan verdwijnt het icoon."
    },
    { "type": "url", "id": "social_instagram", "label": "Instagram-URL" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok-URL" },
    { "type": "url", "id": "social_facebook", "label": "Facebook-URL" },
    { "type": "url", "id": "social_pinterest", "label": "Pinterest-URL" },

    { "type": "header", "content": "Linkkolom 1" },
    {
      "type": "text",
      "id": "footer_heading_1",
      "label": "Kop",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Menu",
      "info": "Maak een menu in Shopify → Content → Menu's en kies het hier. Leeg = we tonen automatisch je collecties."
    },

    { "type": "header", "content": "Linkkolom 2" },
    {
      "type": "text",
      "id": "footer_heading_2",
      "label": "Kop",
      "default": "Klantenservice"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Menu",
      "info": "Leeg = de standaard klantenservice-links."
    },

    { "type": "header", "content": "Linkkolom 3" },
    {
      "type": "text",
      "id": "footer_heading_3",
      "label": "Kop",
      "default": "Over Snoopy Mode"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Menu",
      "info": "Leeg = een standaardlink naar 'Ons verhaal'."
    },

    { "type": "header", "content": "Onderbalk" },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright-tekst",
      "info": "Gebruik {jaar} voor het huidige jaartal.",
      "default": "© {jaar} Snoopy Mode"
    },
    {
      "type": "link_list",
      "id": "footer_legal_menu",
      "label": "Juridische links",
      "info": "Leeg = voorwaarden, privacybeleid en cookies."
    }
  ]
}
{% endschema %}
