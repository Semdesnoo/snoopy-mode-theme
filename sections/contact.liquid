{%- comment -%}
  Contactpagina: links een Shopify {% form 'contact' %}, rechts contactgegevens
  uit de sectie-instellingen + openingstijden (blocks) + Google Maps-embed.
  Daaronder FAQ met native <details> en een rij snelle links.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .page-header {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .page-header__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-top: var(--sp-0_75);
  }
  #shopify-section-{{ section.id }} .page-header__intro {
    color: var(--ink-soft);
    max-width: 46ch;
    margin: var(--sp-1) auto 0;
  }

  #shopify-section-{{ section.id }} .contact-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  #shopify-section-{{ section.id }} .contact-form { display: flex; flex-direction: column; gap: var(--sp-1_5); }
  #shopify-section-{{ section.id }} .contact-form .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-1_5);
  }
  #shopify-section-{{ section.id }} .contact-form__thanks {
    border: var(--border);
    background: var(--surface);
    padding: var(--sp-2);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .contact-form__thanks p:first-child {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--accent-deep);
    margin-bottom: var(--sp-0_5);
  }
  #shopify-section-{{ section.id }} .contact-form__thanks p:last-child { color: var(--muted); font-size: 0.9rem; }

  #shopify-section-{{ section.id }} .contact-info {
    background: var(--bg-alt);
    border: var(--border);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  #shopify-section-{{ section.id }} .contact-info__block { padding-block: var(--sp-1_5); border-bottom: var(--border); }
  #shopify-section-{{ section.id }} .contact-info__block:first-of-type { padding-top: 0; }
  #shopify-section-{{ section.id }} .contact-info__block:last-of-type { border-bottom: none; padding-bottom: 0; }
  #shopify-section-{{ section.id }} .contact-info__label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  #shopify-section-{{ section.id }} .contact-info__block p { color: var(--ink-soft); }
  #shopify-section-{{ section.id }} .contact-info__hours { display: flex; justify-content: space-between; gap: var(--sp-1); }
  #shopify-section-{{ section.id }} .contact-info__hours span:last-child { color: var(--ink); }

  #shopify-section-{{ section.id }} .faq-list {
    max-width: 760px;
    margin-inline: auto;
    border-top: var(--border);
  }
  #shopify-section-{{ section.id }} .faq-item { border-bottom: var(--border); }
  #shopify-section-{{ section.id }} .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-1);
    padding-block: var(--sp-1_5);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    transition: color var(--t-fast);
  }
  #shopify-section-{{ section.id }} .faq-item summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .faq-item summary:hover { color: var(--accent); }
  #shopify-section-{{ section.id }} .faq-item summary .faq-icon {
    flex-shrink: 0;
    width: 18px; height: 18px;
    position: relative;
    transition: transform var(--t-fast);
  }
  #shopify-section-{{ section.id }} .faq-item summary .faq-icon::before,
  #shopify-section-{{ section.id }} .faq-item summary .faq-icon::after {
    content: "";
    position: absolute;
    background: currentColor;
    transition: opacity var(--t-fast);
  }
  #shopify-section-{{ section.id }} .faq-item summary .faq-icon::before { top: 8px; left: 0; width: 18px; height: 1px; }
  #shopify-section-{{ section.id }} .faq-item summary .faq-icon::after { left: 8px; top: 0; width: 1px; height: 18px; }
  #shopify-section-{{ section.id }} .faq-item[open] summary .faq-icon::after { opacity: 0; }
  #shopify-section-{{ section.id }} .faq-item__answer { padding-bottom: var(--sp-1_5); color: var(--ink-soft); max-width: 64ch; }

  #shopify-section-{{ section.id }} .quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-1_5);
  }
  #shopify-section-{{ section.id }} .quick-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--sp-2);
    background: var(--surface);
    border: var(--border);
    transition: border-color var(--t-fast);
  }
  #shopify-section-{{ section.id }} .quick-link:hover { border-color: var(--accent); }
  #shopify-section-{{ section.id }} .quick-link h3 { font-size: 1.1rem; }
  #shopify-section-{{ section.id }} .quick-link p { color: var(--muted); font-size: 0.9rem; }
  #shopify-section-{{ section.id }} .quick-link span {
    margin-top: 0.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  #shopify-section-{{ section.id }} .contact-map {
    display: block;
    width: 100%;
    height: clamp(300px, 42vw, 460px);
    border: 1px solid var(--line);
  }
  #shopify-section-{{ section.id }} .contact-map__link {
    text-align: center;
    margin-top: var(--sp-1);
    font-size: 0.9rem;
  }

  /* Kaart direct onder het formulier: vult de ruimte naast de gegevenskaart. */
  #shopify-section-{{ section.id }} .contact-map-wrap { margin-top: var(--sp-2); }
  #shopify-section-{{ section.id }} .contact-map-wrap .contact-info__label { margin-bottom: var(--sp-0_75); }
  #shopify-section-{{ section.id }} .contact-map--inline { height: clamp(260px, 26vw, 340px); }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .contact-layout { grid-template-columns: 1fr; gap: var(--sp-3); }
    #shopify-section-{{ section.id }} .quick-links { grid-template-columns: 1fr; }
    /* Op mobiel geen extra hoge kaart: hij staat toch onder elkaar. */
    #shopify-section-{{ section.id }} .contact-map--inline { height: 260px; }
  }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .contact-form .field-row { grid-template-columns: 1fr; }
  }

  /* Anti-spam: het controleveld staat buiten beeld in plaats van op
     display:none — verborgen velden slaan bots juist over. Een bezoeker
     ziet en bereikt dit veld nooit. */
  #shopify-section-{{ section.id }} .sm-hp {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  /* Melding als de controle aanslaat: altijd mét een uitweg per e-mail. */
  #shopify-section-{{ section.id }} .contact-form__blocked {
    margin-top: var(--sp-1);
    padding: var(--sp-1);
    border: var(--border);
    border-left: 3px solid var(--accent);
    background: var(--bg-alt);
    font-size: 0.9rem;
  }
{%- endstyle -%}

{%- liquid
  assign info_email = section.settings.company_email | default: shop.email
  assign info_phone = section.settings.company_phone
  assign info_address = section.settings.company_address
  assign map_address = section.settings.map_address | default: info_address

  comment
    Kaart: standaard direct onder het formulier, zodat de lege ruimte naast de
    contactgegevens benut wordt. De eigenaar kan hem ook onderaan zetten of verbergen.
  endcomment
  assign map_position = section.settings.map_position | default: 'form'
  assign has_map = false
  if map_position != 'none'
    if map_address != blank or section.settings.map_embed_url != blank
      assign has_map = true
    endif
  endif

  comment
    De insluitcode van Google accepteren we in elke vorm: hele <iframe ...>, losse
    URL, of niets — dan vallen we terug op een kaart op het bezoekadres.
  endcomment
  assign custom_map = section.settings.map_embed_url | strip
  if custom_map contains 'src="'
    assign custom_map = custom_map | split: 'src="' | last | split: '"' | first
  endif
  if custom_map contains '/maps/embed' or custom_map contains 'output=embed' or custom_map contains 'openstreetmap.org/export'
    assign map_src = custom_map
  else
    assign map_src = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2462.2436144036997!2d4.506440776152254!3d51.89301818246044!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c433082a8898f7%3A0xe83556f1ceaf3349!2sGroene%20Hilledijk%20165-B%2C%203073%20AB%20Rotterdam!5e0!3m2!1snl!2snl!4v1782213152811!5m2!1snl!2snl'
  endif
-%}

<section class="page-header">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="page-header__title reveal" data-delay="1">{{ page.title | default: section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="page-header__intro reveal" data-delay="2">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="contact-layout">

      {%- comment -%} LINKS: Shopify-contactformulier {%- endcomment -%}
      <div class="reveal">
        {%- if form.posted_successfully? -%}
          <div class="contact-form__thanks" role="status" tabindex="-1">
            <p>{{ section.settings.form_success | default: 'Bedankt voor je bericht!' }}</p>
            <p>We hebben je e-mail goed ontvangen en reageren meestal binnen 1 werkdag.</p>
          </div>
        {%- else -%}
          {%- form 'contact', class: 'contact-form' -%}
            {%- if form.errors -%}
              <div class="contact-form__thanks" role="alert" tabindex="-1">
                <p>{{ section.settings.form_error | default: 'Er ging iets mis' }}</p>
                <p>{{ form.errors | default_errors }}</p>
              </div>
            {%- endif -%}

            <div class="field-row">
              <div class="field">
                <label for="contact-naam">{{ section.settings.label_name | default: 'Naam' }}</label>
                <input id="contact-naam" name="contact[name]" type="text" placeholder="{{ section.settings.placeholder_name | default: 'Je naam' | escape }}" autocomplete="name" value="{{ form.name }}" required />
              </div>
              <div class="field">
                <label for="contact-email">{{ section.settings.label_email | default: 'E-mailadres' }}</label>
                <input id="contact-email" name="contact[email]" type="email" placeholder="{{ section.settings.placeholder_email | default: 'Je e-mailadres' | escape }}" autocomplete="email" value="{{ form.email }}" required />
              </div>
            </div>

            <div class="field">
              <label for="contact-onderwerp">{{ section.settings.label_subject | default: 'Onderwerp' }}</label>
              <select id="contact-onderwerp" name="contact[Onderwerp]" required>
                <option value="" disabled selected>{{ section.settings.subject_placeholder | default: 'Kies een onderwerp' }}</option>
                <option value="Bestelling">Bestelling</option>
                <option value="Retour">Retour</option>
                <option value="Maatadvies">Maatadvies</option>
                <option value="Overig">Overig</option>
              </select>
            </div>

            <div class="field">
              <label for="contact-bericht">{{ section.settings.label_message | default: 'Bericht' }}</label>
              <textarea id="contact-bericht" name="contact[body]" placeholder="{{ section.settings.placeholder_message | default: 'Waarmee kunnen we je helpen?' | escape }}" required>{{ form.body }}</textarea>
            </div>

            {%- comment -%}
              Anti-spam. Twee onderdelen:
              1) een controleveld dat buiten beeld staat. Een bezoeker vult dat
                 nooit in, een bot bijna altijd wel.
              2) een stempelveld "Controle" dat in de e-mail meekomt: bij een
                 echt bezoek staat er "ok", anders "SPAMVERDACHT". Bots die
                 rechtstreeks naar /contact posten voeren geen JavaScript uit;
                 bij hen blijft dit veld leeg. Filter in je mailbox dus op het
                 ONTBREKEN van "Controle: ok".
              De attributen tabindex/autocomplete/data-lpignore zijn nodig,
              anders vult een wachtwoordmanager het veld voor de klant in.
            {%- endcomment -%}
            <div class="sm-hp" aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
              <label for="contact-controle-{{ section.id }}">Laat dit veld leeg</label>
              <input id="contact-controle-{{ section.id }}" type="text" name="contact[Laat-leeg]" value="" tabindex="-1" autocomplete="off" data-lpignore="true" data-1p-ignore data-sm-hp>
            </div>
            <input type="hidden" name="contact[Controle]" value="" data-sm-check>

            <button class="btn" type="submit">{{ section.settings.submit_label | default: 'Versturen' }}</button>

            <div class="contact-form__blocked" data-sm-blocked hidden role="alert">
              {{ section.settings.blocked_text | default: 'Onze spamcontrole sloeg even aan. Klik gerust nog een keer op Versturen — dan gaat je bericht gewoon door. Lukt het niet? Mail ons dan rechtstreeks:' | newline_to_br }}
              {%- if info_email != blank -%}
                <br><a class="link-accent" href="mailto:{{ info_email }}">{{ info_email }}</a>
              {%- endif -%}
            </div>
          {%- endform -%}
        {%- endif -%}

        {%- if has_map and map_position == 'form' -%}
          {%- comment -%} Kaart vult de ruimte onder de verstuurknop. {%- endcomment -%}
          <div class="contact-map-wrap">
            {%- if section.settings.map_label != blank -%}
              <p class="contact-info__label">{{ section.settings.map_label }}</p>
            {%- endif -%}
            <iframe class="contact-map contact-map--inline" src="{{ map_src }}" title="Locatie {{ shop.name }}" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
            {%- if map_address != blank -%}
              <p class="contact-map__link">
                <a class="link-accent" href="https://www.google.com/maps/search/?api=1&amp;query={{ map_address | strip_newlines | url_encode }}" target="_blank" rel="noopener noreferrer">{{ section.settings.map_link_label | default: 'Open in Google Maps' }}</a>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} RECHTS: contactgegevens {%- endcomment -%}
      <aside class="contact-info reveal" data-delay="1">
        {%- if info_email != blank -%}
          <div class="contact-info__block">
            <p class="contact-info__label">{{ section.settings.label_email_block | default: 'E-mail' }}</p>
            <p><a class="link-accent" href="mailto:{{ info_email }}">{{ info_email }}</a></p>
          </div>
        {%- endif -%}

        {%- if info_phone != blank -%}
          <div class="contact-info__block">
            <p class="contact-info__label">{{ section.settings.label_phone_block | default: 'Telefoon' }}</p>
            <p><a class="link-accent" href="tel:{{ info_phone | remove: ' ' }}">{{ info_phone }}</a></p>
            {%- if section.settings.phone_note != blank -%}<p class="text-muted" style="font-size:0.85rem;">{{ section.settings.phone_note }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        {%- assign hour_blocks = section.blocks | where: 'type', 'opening_hours' -%}
        {%- if hour_blocks.size > 0 -%}
          <div class="contact-info__block">
            <p class="contact-info__label">{{ section.settings.hours_label }}</p>
            {%- for block in hour_blocks -%}
              <p class="contact-info__hours" {{ block.shopify_attributes }}>
                <span>{{ block.settings.day }}</span><span>{{ block.settings.hours }}</span>
              </p>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if info_address != blank -%}
          <div class="contact-info__block">
            <p class="contact-info__label">{{ section.settings.label_address_block | default: 'Bezoek- & postadres' }}</p>
            <p>{{ info_address | newline_to_br }}</p>
            {%- if section.settings.address_note != blank -%}
              <p class="text-muted" style="font-size:0.85rem; margin-top:0.5rem;">{{ section.settings.address_note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.business_details != blank -%}
          <div class="contact-info__block">
            <p class="contact-info__label">{{ section.settings.label_business_block | default: 'Bedrijfsgegevens' }}</p>
            <p>{{ section.settings.business_details | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </aside>

    </div>
  </div>
</section>

{%- if has_map and map_position == 'bottom' -%}
  <section class="section section--tight">
    <div class="container container--wide">
      <iframe class="contact-map reveal" src="{{ map_src }}" title="Locatie {{ shop.name }}" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
      {%- if map_address != blank -%}
        <p class="contact-map__link">
          <a class="link-accent" href="https://www.google.com/maps/search/?api=1&amp;query={{ map_address | strip_newlines | url_encode }}" target="_blank" rel="noopener noreferrer">{{ section.settings.map_link_label | default: 'Open in Google Maps' }}</a>
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
{%- if faq_blocks.size > 0 -%}
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center reveal">
        {%- if section.settings.faq_eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.faq_eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-head__title">{{ section.settings.faq_heading }}</h2>
        {%- if section.settings.faq_subheading != blank -%}
          <p>{{ section.settings.faq_subheading }}</p>
        {%- endif -%}
      </div>

      <div class="faq-list reveal" data-delay="1" data-accordion>
        {%- for block in faq_blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}<span class="faq-icon" aria-hidden="true"></span></summary>
            <div class="faq-item__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- assign link_blocks = section.blocks | where: 'type', 'quick_link' -%}
{%- if link_blocks.size > 0 -%}
  <section class="section">
    <div class="container container--wide">
      <div class="quick-links">
        {%- for block in link_blocks -%}
          <a class="quick-link reveal" {% if forloop.index0 > 0 %}data-delay="{{ forloop.index0 }}"{% endif %} href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.link_label != blank -%}
              <span>{{ block.settings.link_label }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<script>
  /* Na verzenden: scroll de bevestiging (of foutmelding) in beeld zodat de
     bezoeker meteen ziet dat het bericht is verstuurd. */
  (function () {
    var box = document.querySelector(".contact-form__thanks");
    if (!box) return;
    try { box.scrollIntoView({ behavior: "smooth", block: "center" }); } catch (e) {}
    if (box.focus) box.focus();
  })();

  /* --------------------------------------------------------------------
     Anti-spam-controle op het contactformulier.
     Tegenhouden gebeurt alléén als het verborgen veld is ingevuld — dat
     doet een echte bezoeker nooit — en dan krijgt hij het e-mailadres te
     zien, zodat niemand ooit zonder antwoord achterblijft. Al het andere
     wordt uitsluitend gestempeld in het veld "Controle", nooit geblokkeerd.
     -------------------------------------------------------------------- */
  (function () {
    "use strict";
    /* Binnen deze sectie zoeken, zodat een tweede contactblok op dezelfde
       pagina zijn eigen controle krijgt. */
    var root = document.getElementById("shopify-section-{{ section.id }}");
    var form = (root || document).querySelector(".contact-form");
    if (!form) return;

    var hp = form.querySelector("[data-sm-hp]");
    var mark = form.querySelector("[data-sm-check]");
    var blocked = form.querySelector("[data-sm-blocked]");
    var geladen = Date.now();
    var mens = false;
    /* Onthouden dat het lokveld eerder aansloeg. Anders zou een bot die
       simpelweg twee keer verstuurt bij de tweede poging "ok" krijgen. */
    var eerderBetrapt = false;

    /* Een echte bezoeker typt of tikt in het formulier voordat hij verstuurt;
       een script doet dat niet. Ook het klikken op Versturen telt mee. */
    form.addEventListener("keydown", function () { mens = true; });
    form.addEventListener("pointerdown", function () { mens = true; });

    form.addEventListener("submit", function (e) {
      try {
        var sec = Math.round((Date.now() - geladen) / 1000);
        var lokvink = hp && hp.value !== "";
        if (lokvink) eerderBetrapt = true;

        var val = eerderBetrapt ? "SPAMVERDACHT-lokveld"
                : !mens         ? "SPAMVERDACHT-geen-invoer"
                :                 "ok";

        if (mark) mark.value = val + " (" + sec + " sec)";

        /* Alleen bij een ingevuld lokveld houden we één keer tegen. Daarna
           maken we het veld leeg, zodat een echte bezoeker bij wie dit ten
           onrechte gebeurde gewoon nog een keer op Versturen kan klikken.
           Het stempel blijft wel staan, dus de tweede poging van een bot komt
           gemerkt binnen. */
        if (blocked) blocked.hidden = true;
        if (lokvink) {
          e.preventDefault();
          hp.value = "";
          if (blocked) {
            blocked.hidden = false;
            try { blocked.scrollIntoView({ behavior: "smooth", block: "center" }); } catch (e2) {}
          }
        }
      } catch (e3) {
        /* Gaat er iets mis, dan wordt het bericht gewoon verstuurd. */
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Pagina-header" },
    { "type": "text", "id": "eyebrow", "label": "Bovenkopje (eyebrow)", "default": "Klantcontact" },
    { "type": "text", "id": "heading", "label": "Titel (fallback als pagina geen titel heeft)", "default": "Contact" },
    { "type": "text", "id": "intro", "label": "Introzin", "default": "We helpen je graag — meestal binnen 1 werkdag antwoord." },

