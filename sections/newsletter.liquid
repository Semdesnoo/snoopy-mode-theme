{%- comment -%}
  Nieuwsbrief — inschrijfformulier. Inschrijvingen komen binnen bij
  Shopify → Klanten, met de tag "newsletter".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
{%- capture sm_class -%}{%- render 'sm-section-class', s: s -%}{%- endcapture -%}

<section class="section newsletter {{ sm_class }}">
  <div class="container">
    <div class="newsletter__inner reveal">
      {% if s.eyebrow != blank %}
        <p class="eyebrow">{{ s.eyebrow }}</p>
      {% endif %}
      {% if s.heading != blank %}
        <h2>{{ s.heading }}</h2>
      {% endif %}
      {% if s.text != blank %}
        <p>{{ s.text }}</p>
      {% endif %}

      {% form 'customer', class: 'newsletter-form', novalidate: 'novalidate' %}
        {% if form.posted_successfully? %}
          <p class="newsletter__thanks">{{ s.success_text }}</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="newsletter-email-{{ section.id }}">{{ s.field_placeholder | default: 'Je e-mailadres' }}</label>
          <input id="newsletter-email-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ s.field_placeholder | default: 'Je e-mailadres' | escape }}" autocomplete="email" required>
          <button class="btn" type="submit">{{ s.button_label | default: 'Inschrijven' }}</button>
        {% endif %}
      {% endform %}

      {% if s.disclaimer != blank %}
        <p class="newsletter__disclaimer">{{ s.disclaimer }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nieuwsbrief",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Tekst" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Klein kopje erboven",
      "default": "Blijf op de hoogte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Word lid van de Snoopy Mode-club"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst eronder",
      "default": "Ontvang als eerste nieuwe collecties, stijltips en exclusieve aanbiedingen."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Kleine tekst onderaan",
      "default": "Je kunt je op elk moment uitschrijven."
    },

    { "type": "header", "content": "Formulier" },
    {
      "type": "text",
      "id": "field_placeholder",
      "label": "Tekst in het invoerveld",
      "default": "Je e-mailadres"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Tekst op de knop",
      "default": "Inschrijven"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Bedanktekst na inschrijving",
      "default": "Welkom bij de club! Je hoort snel van ons."
    },

    { "type": "header", "content": "Ruimte & achtergrond" },
    {
      "type": "select",
      "id": "space",
      "label": "Ruimte boven en onder (laptop)",
      "options": [
        { "value": "default", "label": "Standaard" },
        { "value": "none", "label": "Geen" },
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "large", "label": "Groot" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "space_mobile",
      "label": "Ruimte boven en onder (mobiel)",
      "options": [
        { "value": "default", "label": "Standaard" },
        { "value": "none", "label": "Geen" },
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "large", "label": "Groot" }
      ],
      "default": "default"
    },

    { "type": "header", "content": "Zichtbaarheid" },
    { "type": "checkbox", "id": "hide_mobile", "label": "Deze sectie verbergen op mobiel", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Deze sectie verbergen op laptop", "default": false }
  ],
  "presets": [
    { "name": "Nieuwsbrief" }
  ]
}
{% endschema %}
