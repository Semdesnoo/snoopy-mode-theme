{%- comment -%}
  Foto met tekst ernaast — bijvoorbeeld het verhaal van Marjolein & Monique.
  Foto voor laptop en mobiel apart instelbaar, net als de kant waar de foto staat.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ratio = s.image_ratio | default: 'portrait'
  assign wrapper_class = 'media sm-ratio-' | append: ratio
-%}
{%- capture sm_class -%}{%- render 'sm-section-class', s: s -%}{%- endcapture -%}

<section class="section {{ sm_class }}">
  <div class="container container--wide">
    <div class="editorial{% if s.image_position == 'right' %} editorial--reverse{% endif %}">
      <div class="editorial__media reveal">
        {%- render 'sm-photo',
          image: s.image,
          image_mobile: s.image_mobile,
          key: 'editorial',
          alt: s.image_alt | default: s.heading,
          label: s.placeholder_label,
          wrapper_class: wrapper_class,
          loading: 'lazy',
          widths: '400, 600, 800, 1000',
          sizes: '(max-width: 749px) 90vw, 45vw' -%}
      </div>
      <div class="editorial__body reveal" data-delay="1">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2>{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          {{ s.text }}
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="btn btn--outline" href="{{ s.button_link | default: '/pages/over-ons' }}">{{ s.button_label }}</a>
        {%- endif -%}
        {%- if s.show_socials -%}
          {%- render 'sm-socials', label: s.socials_label, style: 'light' -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Foto met tekst",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Foto" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto — laptop & tablet"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Foto — mobiel",
      "info": "Leeg laten = dezelfde foto als op laptop."
    },
    { "type": "text", "id": "image_alt", "label": "Omschrijving van de foto" },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Tekst zolang er nog geen foto is",
      "default": "Marjolein & Monique"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Foto staat (op laptop)",
      "info": "Op mobiel staat de foto altijd boven de tekst.",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Vorm van de foto",
      "options": [
        { "value": "phonefull", "label": "Telefoon volledig scherm (9:19,5)" },
        { "value": "phone", "label": "Telefoonfoto staand (9:16)" },
        { "value": "tall", "label": "Extra staand (2:3)" },
        { "value": "portrait", "label": "Staand (3:4)" },
        { "value": "square", "label": "Vierkant" },
        { "value": "landscape", "label": "Liggend (4:3)" }
      ],
      "default": "portrait"
    },

    { "type": "header", "content": "Tekst" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Klein kopje erboven",
      "default": "Voorstellen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Wij zijn Marjolein en Monique."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Al meer dan 30 jaar zijn wij beste vriendinnen en al nog langer werkzaam in de modebranche.</p><p>In 2002 kregen wij de kans om de winkel waar we zelf werkten over te nemen, een droom die werkelijkheid werd.</p><p>Onze grootste passie? Klanten blij maken en ervoor zorgen dat iedereen met een mooie outfit én een goed gevoel de deur uitgaat.</p><p>De tijden veranderen en daarom hebben wij besloten om naast onze vertrouwde winkel ook online zichtbaar te worden. Zo kunnen we nog meer mensen laten genieten van onze collectie en persoonlijke service.</p><p>Natuurlijk hopen we jullie nog steeds gezellig in onze winkel te mogen ontvangen, maar vanaf nu kun je ook online bij ons terecht.</p><p><em>Liefs, Marjolein &amp; Monique</em></p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Tekst op de knop",
      "default": "Lees ons verhaal"
    },
    { "type": "url", "id": "button_link", "label": "Waar de knop naartoe gaat" },

    { "type": "header", "content": "Sociale media" },
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Knoppen naar Instagram, TikTok en Facebook tonen",
      "info": "De links stel je in bij Thema-instellingen → Sociale media.",
      "default": true
    },
    {
      "type": "text",
      "id": "socials_label",
      "label": "Tekstje ervoor",
      "info": "Leeg laten = alleen de icoontjes.",
      "default": "Volg ons"
    },

    { "type": "header", "content": "Ruimte & achtergrond" },
    {
      "type": "select",
      "id": "space",
      "label": "Ruimte boven en onder (laptop)",
      "options": [
        { "value": "default", "label": "Standaard" },
        { "value": "none", "label": "Geen" },
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "large", "label": "Groot" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "space_mobile",
      "label": "Ruimte boven en onder (mobiel)",
      "options": [
        { "value": "default", "label": "Standaard" },
        { "value": "none", "label": "Geen" },
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Gemiddeld" },
        { "value": "large", "label": "Groot" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Achtergrond",
      "options": [
        { "value": "default", "label": "Standaard" },
        { "value": "alt", "label": "Zachte zandtint" },
        { "value": "white", "label": "Wit" },
        { "value": "dark", "label": "Donker" }
      ],
      "default": "default"
    },

    { "type": "header", "content": "Zichtbaarheid" },
    { "type": "checkbox", "id": "hide_mobile", "label": "Deze sectie verbergen op mobiel", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Deze sectie verbergen op laptop", "default": false }
  ],
  "presets": [
    { "name": "Foto met tekst" }
  ]
}
{% endschema %}
